<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Main Default Polo Config:
  This system allows you to override hardcoded engine limits for custom character sizes and eye
logic. 

  CORE ATTRIBUTES:
  - <sprWidth> / <sprHeight>: The physical dimensions of the Polo sprite. (Standard: 164x400).
  - <eyesTopY>: The 'Anchor' that pins eyes to the face. Lower numbers move eyes UP, Higher moves
them DOWN.
  - <maxPupMove>: The 'Leash' for pupils. Standard is 7. Increase this (e.g., 10) for wider eye
movement.

  THE NUDGE SYSTEM (EYE CLIP FIXING):
  These values act as 'Invisible Walls' to stop pupils from escaping the eye art at high mouse
coordinates.
  - <nudgeRight>: Fixes clipping when looking at right-side edges (like X: 2345). Increase (>1.0) to
push further out.
  - <nudgeLeft>: Controls the left-side boundary. Usually safe at 0.80 or 1.0.
  - <nudgeUp>: The 'Ceiling'. Use a small decimal like 0.100 to stop pupils from disappearing under
the brow.
  - <nudgeDown>: The 'Floor'. Prevents pupils from sinking into the chin or bottom of the eye.

  ANIMATION MAPPING:
  - <sprEyelid1Y> thru <sprEyelid4Y>: The Y-coordinate positions for each blink frame in your
'default-hd.png' file.
  - <id>: Match the <poloMap id="X"> to the Polo's ID in the game to apply these unique rules.
-->

<data>
	<default>
		<polo>
			<sprWidth>164</sprWidth>
			<sprHeight>400</sprHeight>
			<sprEyesH>40</sprEyesH>
			<sprEyesY>0</sprEyesY>
			<sprEyelid1Y>0</sprEyelid1Y>
			<sprEyelid2Y>40</sprEyelid2Y>
			<sprEyelid3Y>80</sprEyelid3Y>
			<sprEyelid4Y>120</sprEyelid4Y>
			<pup1Y>110</pup1Y>
			<pup2Y>110</pup2Y>
			<eyesTopY>97</eyesTopY>
		</polo>
	</default>

